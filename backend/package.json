{
  "name": "lccb-bookstore-api",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "migrate:data:postgres": "node scripts/transferToPostgres.js",
    "migrate:uploads:supabase": "node scripts/transferUploadsToSupabase.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "check": "node scripts/checkSyntax.js",
    "seed:admin": "node scripts/createAdmin.js",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.5.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
